---
import "../../styles/admin.css";
import siteCss from "../../styles/global.css?url";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin · Suyog K.C.</title>
  </head>
  <body>
    <header class="admin-header">
      <a href="/">suyog✳</a>
      <h1>Journal admin</h1>
      <a class="site-link" href="/" target="_blank" rel="noopener">View site ↗</a>
      <button id="logout" class="secondary" hidden>Sign out</button>
    </header>
    <main>
      <p id="status" role="status" aria-live="polite">Loading…</p>
      <section id="login-panel" hidden>
        <h2>Sign in</h2>
        <form id="login-form">
          <label>Username<input id="username" autocomplete="username" required /></label>
          <label>Password<input id="password" type="password" autocomplete="current-password" required /></label>
          <button type="submit">Sign in</button>
        </form>
      </section>
      <section id="workspace" hidden>
        <section id="posts-panel">
          <div class="list-heading">
            <h2>Posts <span id="post-count" class="count-badge"></span></h2>
            <div class="actions">
              <button id="refresh-posts" type="button" class="secondary">Refresh</button>
              <button id="new-post" type="button">New post</button>
            </div>
          </div>
          <div class="post-filters">
            <label>Search<input id="post-search" type="search" placeholder="Title, category or URL…" /></label>
            <label>Status<select id="post-filter"><option value="all">All</option><option value="published">Published</option><option value="draft">Draft</option><option value="scheduled">Scheduled</option></select></label>
          </div>
          <p id="search-status" class="help" role="status"></p>
          <div id="post-list" aria-label="Posts"></div>
        </section>
        <section id="editor-panel" hidden>
          <div class="list-heading">
            <h2 id="editor-title">New post</h2>
            <button id="back-to-list" type="button" class="secondary">← All posts</button>
          </div>
          <form id="post-form">
            <label>Title<input id="title" required maxlength="300" /></label>
            <label>URL<input id="slug" required pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="100" /><small>Lowercase and hyphens, e.g. a-weekend-in-the-mountains. Fixed once saved.</small></label>
            <label>Description<textarea id="description" required maxlength="2000" rows="2"></textarea></label>
            <div class="field-row">
              <label>Category<input id="category" required maxlength="60" list="categories" /><datalist id="categories"></datalist></label>
              <label>Publication date<input id="date" type="date" required /><small>Future dates need another deploy on or after that day.</small></label>
            </div>
            <label>Cover image path<input id="cover" required placeholder="/images/tatos.jpg" /></label>
            <label>Upload cover<input id="cover-file" type="file" accept="image/jpeg,image/png,image/webp,image/gif" /><small>JPG, PNG, WebP or GIF, up to 1 MB each.</small></label>
            <img id="cover-preview" alt="Cover preview" hidden />
            <label>Cover description<input id="cover-alt" required /></label>
            <div class="editor-actions">
              <label for="body" class="body-label">Body (Markdown)</label>
              <button id="preview-draft" type="button" class="secondary">Preview</button>
              <span id="word-count" class="help"></span>
            </div>
            <textarea id="body" rows="22" spellcheck="true"></textarea>
            <div class="field-row">
              <label>Inline image description<input id="inline-alt" maxlength="500" placeholder="What does the image show?" /></label>
              <label>Insert image at cursor<input id="inline-file" type="file" multiple accept="image/jpeg,image/png,image/webp,image/gif" /></label>
            </div>
            <div class="actions">
              <button type="submit" value="draft" class="secondary">Save draft</button>
              <button type="submit" value="publish">Publish</button>
            </div>
            <p class="help">Saving commits to GitHub; the site updates after Netlify rebuilds. Drafts stay off the public site but are visible in the public repository.</p>
          </form>
        </section>
      </section>
      <dialog id="post-preview" aria-labelledby="preview-title">
        <div class="list-heading">
          <span id="preview-title">Preview</span>
          <div class="actions preview-sizes">
            <button type="button" class="secondary" data-width="100%" aria-pressed="true">Desktop</button>
            <button type="button" class="secondary" data-width="390px" aria-pressed="false">Mobile</button>
            <button id="close-preview" type="button" class="secondary">Close</button>
          </div>
        </div>
        <iframe id="preview-frame" title="Post preview" sandbox="allow-same-origin" data-css={siteCss}></iframe>
      </dialog>
      <noscript><p>Enable JavaScript to use the editor.</p></noscript>
    </main>
    <script>
      import "../../lib/admin";
    </script>
  </body>
</html>
